# KKCommerce production backend
NODE_ENV=production
PORT=5001

# Production PostgreSQL connection string (Railway PostgreSQL or Neon)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Use a long random secret in production
JWT_SECRET=CHANGE_TO_A_LONG_RANDOM_PRODUCTION_SECRET

# Allowed storefront/admin origins. Comma-separated.
FRONTEND_URL=https://shop.kkcloset.uk
FRONTEND_URLS=https://kkcloset.uk,https://shop.kkcloset.uk,https://admin.kkcloset.uk

# Payments remain OFF for the first deployment.
PAYMENTS_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Existing Cloudflare R2 product images
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kkcloset-products
R2_PUBLIC_URL=https://images.kkcloset.uk
